PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# MongoDB Connection (Local or Atlas)
# Local: mongodb://127.0.0.1:27017/streakforge
# Atlas: mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/streakforge?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/streakforge?retryWrites=true&w=majority

# JWT Secrets (generate strong random secrets for production)
JWT_ACCESS_SECRET=streakforge_jwt_access_secret_super_secure_key_123!@#
JWT_REFRESH_SECRET=streakforge_jwt_refresh_secret_super_secure_key_456!@#
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Google Gemini API Key (Optional for mock mode, required for live AI)
GEMINI_API_KEY=
